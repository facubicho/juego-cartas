# Configuración del conector de chat de TikTok LIVE.
# Copiá este archivo, renombrá la copia a ".env" y completá tus datos.
# El archivo .env NO se sube a GitHub.

# Tu nombre de usuario de TikTok, sin @ (el que aparece en tiktok.com/@usuario)
TIKTOK_USUARIO=usuario_de_ejemplo

# Qué mostrar en pantalla para cada jugador: "apodo" (el nombre que eligió) o "usuario" (su @usuario único)
MOSTRAR_NOMBRE=apodo

# Puerto del servidor local. Si lo cambiás, abrí el juego con ?chat=ws://localhost:ESTE_PUERTO
PUERTO=8080

# Máximo de comentarios por segundo que se pasan al juego (el resto se descarta)
MAX_MENSAJES_POR_SEGUNDO=15

# Largo máximo de cada comentario (en caracteres)
LARGO_MAXIMO=100
