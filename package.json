{
  "name": "juego-cartas",
  "version": "2.0.0",
  "description": "Adiviná y llegá a 10: juego de cartas para lives de TikTok",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "conector": "node conector/index.js",
    "chat:prueba": "node conector/index.js --prueba",
    "chat:prueba-cortes": "node conector/index.js --prueba --cortes",
    "actualizar-qr": "node -e \"require('fs').copyFileSync('node_modules/qrcode-generator/dist/qrcode.js','js/vendor/qrcode.js')\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "tiktok-live-connector": "2.5.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "qrcode-generator": "2.0.4"
  }
}
