# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comparador
# Base aparte para los tests (se borra y recrea en cada corrida)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/comparador_test

# API de Anthropic (nunca la subas al repo)
ANTHROPIC_API_KEY=

# Tope de gasto mensual global en USD. Al alcanzarlo no se generan análisis nuevos.
TOPE_GASTO_MENSUAL_USD=20

# User-Agent con el que la app se identifica ante los diarios.
# Poné una URL o casilla de contacto del proyecto, no datos personales.
USER_AGENT=ComparadorCobertura/0.1 (+https://ejemplo.org/contacto)

# Medios activos (ids de config/medios.ts separados por coma). Vacío = todos.
MEDIOS_ACTIVOS=

# Emails con acceso a /admin, separados por coma
ADMIN_EMAILS=
